<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Happy Veggie World | Global Farming Game</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Fredoka (ポップで世界共通の丸文字) & Zen Maru Gothic -->
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Zen+Maru+Gothic:wght@500;700;900&display=swap" rel="stylesheet">
  <!-- Tone.js (効果音生成ライブラリ - 外部音声ファイル不要) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
  <style>
    body {
      font-family: 'Fredoka', 'Zen Maru Gothic', sans-serif;
      transition: background 1.5s ease;
      min-height: 100vh;
      user-select: none;
    }

    /* 天気に応じた背景グラデーション */
    body.weather-sunny {
      background: linear-gradient(135deg, #e0f7fa 0%, #e8f5e9 55%, #fffde7 100%);
    }
    body.weather-rainy {
      background: linear-gradient(135deg, #cfd8dc 0%, #b0bec5 50%, #e0f2f1 100%);
    }
    body.weather-rainbow {
      background: linear-gradient(135deg, #fce4ec 0%, #fff9c4 35%, #e8f5e9 70%, #e1f5fe 100%);
    }

    /* 畑のタイルデザイン */
    .farm-plot {
      background: radial-gradient(circle at center, #8d6e63 0%, #6d4c41 100%);
      border: 4px solid #5d4037;
      box-shadow: inset 0 6px 12px rgba(0, 0, 0, 0.35), 0 4px 6px rgba(0, 0, 0, 0.1);
      transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease;
    }
    .farm-plot:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: inset 0 6px 12px rgba(0, 0, 0, 0.35), 0 10px 18px rgba(0, 0, 0, 0.15);
    }
    .farm-plot:active {
      transform: translateY(1px) scale(0.98);
    }
    .farm-plot.watered {
      background: radial-gradient(circle at center, #5d4037 0%, #3e2723 100%);
      border-color: #3e2723;
    }
    .farm-plot.dry {
      background: radial-gradient(circle at center, #bcaaa4 0%, #8d6e63 100%);
      border-color: #795548;
    }
    .farm-plot.withered {
      background: radial-gradient(circle at center, #424242 0%, #212121 100%);
      border-color: #d32f2f;
    }

    /* アニメーション */
    @keyframes bounceSlow {
      0%, 100% { transform: translateY(0) scale(1); }
      50% { transform: translateY(-6px) scale(1.05); }
    }
    .animate-crop {
      animation: bounceSlow 2.2s infinite ease-in-out;
    }

    @keyframes readyGlow {
      0%, 100% { filter: drop-shadow(0 0 6px rgba(250, 204, 21, 0.85)); transform: scale(1.06) rotate(-3deg); }
      50% { filter: drop-shadow(0 0 18px rgba(250, 204, 21, 1)); transform: scale(1.18) rotate(3deg); }
    }
    .animate-ready {
      animation: readyGlow 1.3s infinite ease-in-out;
    }

    @keyframes floatUp {
      0% { opacity: 1; transform: translateY(0) scale(0.8); }
      50% { opacity: 1; transform: translateY(-25px) scale(1.2); }
      100% { opacity: 0; transform: translateY(-50px) scale(1); }
    }
    .floating-text {
      animation: floatUp 1.1s ease-out forwards;
      pointer-events: none;
    }

    /* 雨粒アニメーション */
    .rain-overlay {
      background-image: radial-gradient(#4fc3f7 1.5px, transparent 1.5px);
      background-size: 24px 24px;
      animation: rainFall 0.8s linear infinite;
    }
    @keyframes rainFall {
      0% { background-position: 0 0; }
      100% { background-position: -12px 24px; }
    }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: rgba(0,0,0,0.04); border-radius: 10px; }
    ::-webkit-scrollbar-thumb { background: #81c784; border-radius: 10px; }
  </style>
</head>
<body class="weather-sunny text-stone-800 antialiased flex flex-col relative">

  <!-- 雨エフェクト用レイヤー -->
  <div id="rain-layer" class="fixed inset-0 pointer-events-none z-10 opacity-0 transition-opacity duration-1000 rain-overlay"></div>

  <!-- ヘッダー -->
  <header class="bg-white/85 backdrop-blur-md shadow-sm sticky top-0 z-30 border-b border-emerald-100">
    <div class="max-w-6xl mx-auto px-3 sm:px-5 py-2.5 flex flex-wrap items-center justify-between gap-2">
      
      <!-- ロゴ＆タイトル -->
      <div class="flex items-center gap-2.5">
        <div class="w-10 h-10 bg-gradient-to-br from-emerald-400 to-teal-600 rounded-2xl flex items-center justify-center text-white text-2xl shadow-md">
          🌍
        </div>
        <div>
          <h1 class="text-base sm:text-xl font-black text-emerald-900 tracking-tight leading-tight">
            Happy Veggie World
          </h1>
          <p class="text-[11px] text-emerald-600 font-bold" id="sync-status">Connecting...</p>
        </div>
      </div>

      <!-- コントロール群（天気・言語・サウンド・コイン・ログイン） -->
      <div class="flex items-center gap-1.5 sm:gap-2.5 flex-wrap">
        
        <!-- 天気バッジ -->
        <div id="weather-badge" class="bg-sky-50 border border-sky-200 px-2.5 py-1 rounded-xl flex items-center gap-1.5 text-xs font-bold text-sky-900 shadow-sm" title="Global Weather">
          <span id="weather-icon" class="text-base">☀️</span>
          <span id="weather-label" class="hidden md:inline">Sunny</span>
        </div>

        <!-- 言語切り替えボタン -->
        <div class="bg-stone-100 p-0.5 rounded-xl border border-stone-200 flex items-center text-xs font-bold">
          <button onclick="window.setLanguage('ja')" id="lang-ja" class="px-2 py-1 rounded-lg transition">🇯🇵</button>
          <button onclick="window.setLanguage('en')" id="lang-en" class="px-2 py-1 rounded-lg transition">🇺🇸</button>
          <button onclick="window.setLanguage('es')" id="lang-es" class="px-2 py-1 rounded-lg transition">🇪🇸</button>
        </div>

        <!-- サウンド切り替え -->
        <button id="sound-toggle" onclick="window.toggleSound()" class="bg-stone-100 hover:bg-stone-200 text-stone-700 p-2 rounded-xl border border-stone-200 text-xs transition" title="Toggle Sound">
          🔊
        </button>

        <!-- ファーマーレベル＆EXP表示 -->
        <div class="bg-emerald-100 border-2 border-emerald-300 px-2.5 py-1 rounded-2xl flex flex-col justify-center shadow-inner min-w-[76px]">
          <div class="flex items-center justify-between text-[11px] font-black text-emerald-900 leading-none">
            <span>🎓 Lv.<span id="level-display">1</span></span>
            <span id="exp-text" class="text-[9px] text-emerald-700">0/50</span>
          </div>
          <div class="w-full bg-emerald-200/80 h-1.5 rounded-full overflow-hidden mt-1">
            <div id="exp-bar" class="bg-emerald-600 h-full transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>

        <!-- コイン表示 -->
        <div class="bg-amber-100 border-2 border-amber-300 px-3 py-1 rounded-2xl flex items-center gap-1.5 shadow-inner">
          <span class="text-base sm:text-lg">🪙</span>
          <span id="coin-display" class="font-black text-amber-800 text-sm sm:text-base">100</span>
        </div>

        <!-- ユーザー情報 / ログインボタン -->
        <div id="auth-area" class="flex items-center"></div>
      </div>
    </div>
  </header>

  <!-- メインコンテンツ -->
  <main class="flex-grow max-w-6xl w-full mx-auto px-3 sm:px-5 py-5 grid grid-cols-1 lg:grid-cols-12 gap-5 relative z-20">

    <!-- 左側：農園エリア (7カラム) -->
    <section class="lg:col-span-7 flex flex-col gap-4">
      <div class="bg-white/90 backdrop-blur rounded-3xl p-4 sm:p-6 shadow-lg border border-emerald-100">
        
        <!-- 農園ヘッダー＆一括アクション -->
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
          <div>
            <h2 class="text-lg sm:text-xl font-black text-emerald-900 flex items-center gap-2">
              <span>🚜</span> <span data-i18n="farmTitle">あなたの農園</span>
            </h2>
            <p id="weather-bonus-text" class="text-xs font-bold text-amber-600 mt-0.5"></p>
          </div>

          <div class="flex items-center gap-2">
            <button onclick="window.harvestAllReady()" class="bg-amber-400 hover:bg-amber-500 active:scale-95 text-amber-950 font-black text-xs px-3 py-2 rounded-xl shadow-sm transition flex items-center gap-1">
              <span>🧺</span> <span data-i18n="harvestAll">一括収穫</span>
            </button>
          </div>
        </div>

        <!-- 3x3 畑グリッド -->
        <div id="farm-grid" class="grid grid-cols-3 gap-3 sm:gap-4 aspect-square max-w-md mx-auto">
          <!-- JSで9つの区画を生成 -->
        </div>

        <!-- 農具・お世話ツールバー -->
        <div class="mt-4 bg-emerald-50/90 rounded-2xl p-2.5 border border-emerald-200">
          <div class="text-[11px] font-black text-emerald-900 mb-1.5 flex items-center justify-between">
            <span>🧰 <span data-i18n="toolTitle">農具・肥料ツール（選択して畑をタップ）</span></span>
            <span id="selected-tool-desc" class="text-emerald-700 font-bold"></span>
          </div>
          <div id="tool-bar" class="grid grid-cols-5 gap-1.5">
            <!-- JSでツールボタンを生成 -->
          </div>
        </div>

        <!-- 操作ガイド -->
        <div class="mt-3 bg-stone-50/90 rounded-2xl p-2.5 text-[11px] text-stone-600 flex flex-wrap justify-around gap-1.5 border border-stone-200 font-bold">
          <div class="flex items-center gap-1"><span>💧</span> <span data-i18n="guideWater">水分0%で枯死</span></div>
          <div class="flex items-center gap-1"><span>⏰</span> <span data-i18n="guideRot">収穫放置で腐敗</span></div>
          <div class="flex items-center gap-1"><span>🧪</span> <span data-i18n="guideFert">肥料で品質＆速度UP</span></div>
        </div>
      </div>
    </section>

    <!-- 右側：タネショップ＆世界ランキング＆実績 (5カラム) -->
    <section class="lg:col-span-5 flex flex-col gap-4">
      
      <!-- タネショップ -->
      <div class="bg-white/90 backdrop-blur rounded-3xl p-4 sm:p-5 shadow-lg border border-amber-100">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-base sm:text-lg font-black text-amber-900 flex items-center gap-2">
            <span>🏪</span> <span data-i18n="shopTitle">タネショップ</span>
            <span class="text-[11px] bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full font-black">26 Crops</span>
          </h2>
          <span class="text-xs text-stone-500 font-bold" data-i18n="selectSeed">タネを選択</span>
        </div>

        <div id="seed-shop" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-2 gap-2 max-h-72 overflow-y-auto pr-1">
          <!-- JSでタネ一覧を生成 -->
        </div>
      </div>

      <!-- タブ切り替え（世界ランキング / 収穫実績） -->
      <div class="bg-white/90 backdrop-blur rounded-3xl p-4 sm:p-5 shadow-lg border border-emerald-100 flex-grow flex flex-col">
        <div class="flex items-center gap-2 mb-3 bg-stone-100 p-1 rounded-2xl">
          <button onclick="window.switchTab('ranking')" id="tab-ranking" class="flex-1 py-1.5 px-3 rounded-xl text-xs sm:text-sm font-black transition bg-white text-emerald-800 shadow-sm">
            🏆 <span data-i18n="worldRanking">世界ランキング</span>
          </button>
          <button onclick="window.switchTab('stats')" id="tab-stats" class="flex-1 py-1.5 px-3 rounded-xl text-xs sm:text-sm font-black transition text-stone-500 hover:text-stone-700">
            📊 <span data-i18n="myHarvest">収穫データ</span>
          </button>
        </div>

        <!-- 世界ランキングビュー -->
        <div id="view-ranking" class="space-y-2 max-h-64 overflow-y-auto pr-1 flex-grow">
          <p class="text-xs text-stone-400 text-center py-6">Loading World Farmers...</p>
        </div>

        <!-- 収穫実績ビュー -->
        <div id="view-stats" class="space-y-2 max-h-64 overflow-y-auto pr-1 flex-grow hidden">
          <!-- JSで統計を生成 -->
        </div>
      </div>

    </section>
  </main>

  <!-- カスタムメッセージ通知トースト -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Firebase SDK & ゲームロジック -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { 
      getAuth, 
      GoogleAuthProvider, 
      signInWithPopup, 
      signOut, 
      onAuthStateChanged,
      signInWithCustomToken,
      signInAnonymously
    } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { 
      getFirestore, 
      doc, 
      setDoc, 
      onSnapshot,
      collection
    } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    // ==========================================
    // 1. Firebase 初期化設定
    // ==========================================
    const defaultFirebaseConfig = {
      apiKey: "AIzaSyAhuXLkwfJFtUbgacAGXur_jUVcYebDxLM",
      authDomain: "yasaigame.firebaseapp.com",
      projectId: "yasaigame",
      storageBucket: "yasaigame.firebasestorage.app",
      messagingSenderId: "996649365639",
      appId: "1:996649365639:web:670cc98c23d92de4354822"
    };

    const firebaseConfig = (typeof __firebase_config !== 'undefined' && __firebase_config)
      ? JSON.parse(__firebase_config)
      : defaultFirebaseConfig;

    const appId = (typeof __app_id !== 'undefined' && __app_id)
      ? __app_id
      : 'yasaigame-world';

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);
    const googleProvider = new GoogleAuthProvider();

    // ==========================================
    // 2. 多言語辞書データ (日本語 / English / Español)
    // ==========================================
    let currentLang = 'ja';

    const I18N = {
      ja: {
        farmTitle: 'あなたの農園',
        harvestAll: '一括収穫',
        toolTitle: '農具・肥料ツール（選択して畑をタップ）',
        guideWater: '水分0%で枯死',
        guideRot: '収穫放置で腐敗',
        guideFert: '肥料で品質＆速度UP',
        shopTitle: 'タネショップ',
        selectSeed: 'タネを選択',
        worldRanking: '世界ランキング',
        myHarvest: '収穫図鑑',
        weatherSunny: '☀️ 快晴：土壌が乾燥しやすい',
        weatherRainy: '🌧️ 恵みの雨：自動水やり＆成長2倍！',
        weatherRainbow: '🌈 虹の日：収穫コイン1.5倍ボーナス！',
        toolHand: 'タネ/水',
        descHand: '空き地にタネまき / 作物に水やり',
        toolWater: 'ジョウロ',
        descWater: '水分+45%（100%超で根腐れ注意！）',
