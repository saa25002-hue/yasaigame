    const TOOLS = [
      { id: 'hand', icon: '🧤', labelKey: 'toolHand', descKey: 'descHand', cost: 0 },
      { id: 'water', icon: '🚿', labelKey: 'toolWater', descKey: 'descWater', cost: 0 },
      { id: 'speedFert', icon: '⚡', labelKey: 'toolSpeed', descKey: 'descSpeed', cost: 15 },
      { id: 'qualityFert', icon: '💎', labelKey: 'toolQuality', descKey: 'descQuality', cost: 30 },
      { id: 'shovel', icon: '⛏️', labelKey: 'toolShovel', descKey: 'descShovel', cost: 0 }
    ];

    // ==========================================
    // 4. サウンドエフェクト (Tone.js)
    // ==========================================
    let soundEnabled = true;
    let synth = null;

    function playSound(type) {
      if (!soundEnabled || typeof Tone === 'undefined') return;
      try {
        if (Tone.context.state !== 'running') {
          Tone.start();
        }
        if (!synth) {
          synth = new Tone.PolySynth(Tone.Synth, {
            oscillator: { type: 'triangle' },
            envelope: { attack: 0.01, decay: 0.15, sustain: 0.05, release: 0.2 }
          }).toDestination();
          synth.volume.value = -10;
        }

        const now = Tone.now();
        if (type === 'plant') {
          synth.triggerAttackRelease('C5', '16n', now);
        } else if (type === 'water') {
          synth.triggerAttackRelease('E5', '16n', now);
          synth.triggerAttackRelease('G5', '16n', now + 0.06);
        } else if (type === 'fert') {
          synth.triggerAttackRelease('A5', '16n', now);
          synth.triggerAttackRelease('E6', '16n', now + 0.06);
        } else if (type === 'wither') {
          synth.triggerAttackRelease('C3', '8n', now);
          synth.triggerAttackRelease('B2', '8n', now + 0.12);
        } else if (type === 'shovel') {
          synth.triggerAttackRelease('G3', '16n', now);
        } else if (type === 'harvest') {
          synth.triggerAttackRelease('C5', '16n', now);
          synth.triggerAttackRelease('E5', '16n', now + 0.07);
          synth.triggerAttackRelease('G5', '16n', now + 0.14);
          synth.triggerAttackRelease('C6', '8n', now + 0.21);
        }
      } catch (e) {}
    }

    window.toggleSound = () => {
      soundEnabled = !soundEnabled;
      document.getElementById('sound-toggle').textContent = soundEnabled ? '🔊' : '🔇';
    };

    // ==========================================
    // 5. グローバル天気システム (全プレイヤー共通時間ベース)
    // ==========================================
    // 3分(180秒)周期で世界の天気が変化（全ユーザー同じ時間帯に同じ天気になる）
    function getCurrentWeather() {
      const cycleSec = Math.floor(Date.now() / 1000) % 180;
      if (cycleSec < 100) return 'sunny';     // 100秒間: 快晴
      if (cycleSec < 150) return 'rainy';     // 50秒間: 恵みの雨（成長2倍）
      return 'rainbow';                       // 30秒間: 虹（売値1.5倍）
    }

    let lastWeather = null;
    function updateWeatherUI() {
      const weather = getCurrentWeather();
      if (weather !== lastWeather) {
        lastWeather = weather;
        document.body.className = `weather-${weather} text-stone-800 antialiased flex flex-col relative`;
        const rainLayer = document.getElementById('rain-layer');
        rainLayer.style.opacity = weather === 'rainy' ? '0.45' : '0';
      }

      const iconEl = document.getElementById('weather-icon');
      const labelEl = document.getElementById('weather-label');
      const bonusEl = document.getElementById('weather-bonus-text');

      if (weather === 'sunny') {
        iconEl.textContent = '☀️';
        labelEl.textContent = 'Sunny';
        bonusEl.textContent = t('weatherSunny');
        bonusEl.className = 'text-xs font-bold text-emerald-600 mt-0.5';
      } else if (weather === 'rainy') {
        iconEl.textContent = '🌧️';
        labelEl.textContent = 'Rainy x2';
        bonusEl.textContent = t('weatherRainy');
        bonusEl.className = 'text-xs font-bold text-sky-600 mt-0.5 animate-pulse';
      } else {
        iconEl.textContent = '🌈';
        labelEl.textContent = 'Rainbow x1.5';
        bonusEl.textContent = t('weatherRainbow');
        bonusEl.className = 'text-xs font-bold text-pink-600 mt-0.5 animate-pulse';
      }
    }

    // ==========================================
    // 6. アプリケーション状態 & Firestore同期
    // ==========================================
    let currentUser = null;
    let unsubscribeUser = null;
    let unsubscribeLeaderboard = null;
    let selectedSeedId = 'radish';
    let selectedToolId = 'hand';
    let activeTab = 'ranking';
    let leaderboardData = [];

    const emptyPlot = () => ({
      cropId: null,
      progressSec: 0,      // 累積成長秒数
      water: 60,           // 水分ゲージ (0〜100%, 0または100超で枯死)
      speedFert: false,    // 成長肥料フラグ
      qualityFert: false,  // 品質肥料フラグ
      readySince: null,    // 100%到達時刻(ms)
      isWithered: false,   // 枯死フラグ
      witherReason: null   // 'dry' | 'rot' | 'overwater'
    });

    const createInitialGameState = () => ({
      coins: 120,
      exp: 0,
      totalHarvested: 0,
      plots: Array.from({ length: 9 }, () => emptyPlot()),
      harvestCounts: {},
      lastTickAt: Date.now(),
      updatedAt: Date.now()
    });

    let gameState = createInitialGameState();

    // 経験値から現在のファーマーレベルを計算 (Lv.1スタート)
    function getFarmerLevelInfo(exp = 0) {
      let level = 1;
      let required = 50;
      let remainingExp = exp;

      while (remainingExp >= required) {
        remainingExp -= required;
        level++;
        required = Math.floor(required * 1.45);
      }

      return {
        level,
        currentExp: remainingExp,
        nextLevelExp: required,
        percent: Math.min(100, Math.floor((remainingExp / required) * 100))
      };
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = {
        info: 'bg-stone-800 text-white border-stone-600',
        success: 'bg-emerald-600 text-white border-emerald-400',
        warning: 'bg-amber-500 text-white border-amber-300',
        error: 'bg-rose-600 text-white border-rose-400'
      };

      toast.className = `${colors[type]} border px-4 py-2 rounded-2xl shadow-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0`;
      toast.textContent = message;
      container.appendChild(toast);

      requestAnimationFrame(() => toast.classList.remove('translate-y-2', 'opacity-0'));
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 2500);
    }

    function showFloatingEffect(plotIndex, text, colorClass = 'text-amber-300') {
      const plotEl = document.querySelector(`[data-plot-index="${plotIndex}"]`);
      if (!plotEl) return;
      const floater = document.createElement('div');
      floater.className = `floating-text absolute inset-0 flex items-center justify-center font-black text-base sm:text-lg drop-shadow-md z-20 ${colorClass}`;
      floater.textContent = text;
      plotEl.appendChild(floater);
      setTimeout(() => floater.remove(), 1100);
    }

    // 個人データパス（ルール1準拠）
    function getUserDocRef(uid) {
      return doc(db, 'artifacts', appId, 'users', uid, 'gameData', 'farmState');
    }

    // 世界ランキング用公開データパス（ルール1準拠）
    function getPublicLeaderboardDocRef(uid) {
      return doc(db, 'artifacts', appId, 'public', 'data', 'worldFarmers', uid);
    }

    async function saveGameState() {
      renderAll();
      if (!currentUser) return;

      try {
        gameState.updatedAt = Date.now();
        await setDoc(getUserDocRef(currentUser.uid), gameState, { merge: true });

        // Googleログインユーザーは世界ランキングにもスコアを反映
        if (!currentUser.isAnonymous) {
          const totalHarvest = Object.values(gameState.harvestCounts || {}).reduce((a, b) => a + b, 0);
          const lvlInfo = getFarmerLevelInfo(gameState.exp || 0);
          await setDoc(getPublicLeaderboardDocRef(currentUser.uid), {
            uid: currentUser.uid,
            name: currentUser.displayName || 'Global Farmer',
            photoURL: currentUser.photoURL || '',
            coins: gameState.coins,
            level: lvlInfo.level,
            totalHarvest: totalHarvest,
            lang: currentLang,
            updatedAt: Date.now()
          }, { merge: true });
        }
      } catch (error) {
        console.error("Save error:", error);
      }
    }

    // 世界ランキングのリアルタイム購読（ルール2準拠：orderByを使わずメモリでソート）
    function startListeningLeaderboard() {
      if (unsubscribeLeaderboard) unsubscribeLeaderboard();
      const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'worldFarmers');

      unsubscribeLeaderboard = onSnapshot(colRef, (snapshot) => {
        const list = [];
        snapshot.forEach((docSnap) => {
          list.push(docSnap.data());
        });
        // 総収穫数 ＋ コイン価値で総合スコア計算して降順ソート
        list.sort((a, b) => {
          const scoreA = (a.totalHarvest || 0) * 100 + (a.coins || 0);
          const scoreB = (b.totalHarvest || 0) * 100 + (b.coins || 0);
          return scoreB - scoreA;
        });
        leaderboardData = list.slice(0, 10);
        renderLeaderboard();
      }, (error) => {
        // Firestoreルールで未許可の場合でもエラーを握りつぶし、自分のローカル順位を表示
        if (currentUser && !currentUser.isAnonymous) {
          const totalHarvest = Object.values(gameState.harvestCounts || {}).reduce((a, b) => a + b, 0);
          const lvlInfo = getFarmerLevelInfo(gameState.exp || 0);
          leaderboardData = [{
            uid: currentUser.uid,
            name: currentUser.displayName || 'Farmer',
            coins: gameState.coins,
            level: lvlInfo.level,
            totalHarvest,
            lang: currentLang
          }];
        } else {
          leaderboardData = [];
        }
        renderLeaderboard();
      });
    }

    function startListeningUserData(uid) {
      if (unsubscribeUser) unsubscribeUser();
      const docRef = getUserDocRef(uid);
      document.getElementById('sync-status').textContent = t('syncing');

      unsubscribeUser = onSnapshot(docRef, async (docSnap) => {
        if (docSnap.exists()) {
          const data = docSnap.data();
          gameState = { ...createInitialGameState(), ...data };
          if (!Array.isArray(gameState.plots) || gameState.plots.length !== 9) {
            gameState.plots = createInitialGameState().plots;
          } else {
            // 古いデータ構造との互換性確保
            gameState.plots = gameState.plots.map(p => ({ ...emptyPlot(), ...p }));
          }
          gameState.lastTickAt = Date.now();
        } else {
          gameState = createInitialGameState();
          await setDoc(docRef, gameState);
        }
        document.getElementById('sync-status').textContent = t('cloudSaved');
        renderAll();
      }, (error) => {
        console.error("User data error:", error);
      });
    }

    // ==========================================
    // 8. ゲームプレイ・ロジック（本格シミュレーション）
    // ==========================================
    function getPlotProgress(plot) {
      if (!plot.cropId) return 0;
      const crop = CROPS[plot.cropId];
      if (!crop) return 0;
      return Math.min(1, Math.max(0, (plot.progressSec || 0) / crop.growTimeSec));
    }

    function getSellPriceWithBonuses(crop, plot) {
      let price = crop.sellPrice;
      if (plot && plot.qualityFert) price *= 1.5;
      if (getCurrentWeather() === 'rainbow') price *= 1.5;
      return Math.round(price);
    }

    // 毎秒のリアルタイムシミュレーション（成長・水分減少・枯死判定）
    function simulateTick() {
      const now = Date.now();
      const dtSec = Math.min(5, Math.max(0.1, (now - (gameState.lastTickAt || now)) / 1000));
      gameState.lastTickAt = now;

      const weather = getCurrentWeather();
      let stateChanged = false;
      let someoneWithered = false;

      gameState.plots.forEach((plot, idx) => {
        if (!plot.cropId || plot.isWithered) return;
        const crop = CROPS[plot.cropId];
        if (!crop) return;

        const progress = getPlotProgress(plot);

        // 1. まだ成長途中の場合
        if (progress < 1) {
          // 天気による水分変化（雨なら自動回復、快晴なら乾燥加速）
          if (weather === 'rainy') {
            plot.water = Math.min(95, (plot.water ?? 60) + 4 * dtSec);
          } else {
            const sunnyFactor = weather === 'sunny' ? 1.25 : 1.0;
            plot.water = Math.max(0, (plot.water ?? 60) - crop.waterDrainPerSec * sunnyFactor * dtSec);
          }

          // 水分0%で枯死！
          if (plot.water <= 0) {
            plot.water = 0;
            plot.isWithered = true;
            plot.witherReason = 'dry';
            someoneWithered = true;
            stateChanged = true;
            showFloatingEffect(idx, '🥀DRY!', 'text-rose-400');
            return;
          }

          // 水分が適切（20%〜85%）ならベスト成長、それ以外は成長鈍化
          let waterEfficiency = 1.0;
          if (plot.water < 20) waterEfficiency = 0.4;
          else if (plot.water > 85) waterEfficiency = 0.7;

          const weatherSpeed = weather === 'rainy' ? 2.0 : 1.0;
          const fertSpeed = plot.speedFert ? 1.6 : 1.0;

          plot.progressSec = (plot.progressSec || 0) + dtSec * waterEfficiency * weatherSpeed * fertSpeed;
          stateChanged = true;

          // 100%到達チェック
          if (plot.progressSec >= crop.growTimeSec) {
            plot.progressSec = crop.growTimeSec;
            plot.readySince = now;
          }
        } else {
          // 2. 収穫可能状態（100%）の鮮度カウントダウン
          if (!plot.readySince) plot.readySince = now;
          const elapsedReadySec = (now - plot.readySince) / 1000;
          if (elapsedReadySec >= crop.freshTimeSec) {
            plot.isWithered = true;
            plot.witherReason = 'rot';
            someoneWithered = true;
            stateChanged = true;
            showFloatingEffect(idx, '🥀ROT!', 'text-rose-400');
          }
        }
      });

      if (someoneWithered) {
        playSound('wither');
        showToast(t('witheredDry'), 'error');
        saveGameState();
      } else if (stateChanged) {
        renderFarm();
      }
    }

    async function handlePlotClick(index) {
      const plot = gameState.plots[index];

      // 【ツール：スコップ】いつでも撤去可能
      if (selectedToolId === 'shovel') {
        if (!plot.cropId) return;
        playSound('shovel');
        gameState.plots[index] = emptyPlot();
        showFloatingEffect(index, '⛏️', 'text-stone-300');
        showToast(t('cleanedPlot'), 'info');
        await saveGameState();
        return;
      }

      // 枯れている場合はスコップを促す
      if (plot.cropId && plot.isWithered) {
        playSound('wither');
        showToast(t('needShovel'), 'warning');
        return;
      }

      // 【空き地の場合】：手ツール（またはタネ選択）でタネまき
      if (!plot.cropId) {
        if (selectedToolId !== 'hand') {
          window.selectTool('hand');
        }
        const crop = CROPS[selectedSeedId];
        const lvlInfo = getFarmerLevelInfo(gameState.exp || 0);
        if (lvlInfo.level < crop.reqLevel) {
          showToast(`🔒 Lv.${crop.reqLevel} ${t('levelLocked')}`, 'warning');
          return;
        }
        if (gameState.coins < crop.seedCost) {
          showToast(`${t('notEnoughCoins')} (${crop.seedCost}🪙)`, 'warning');
          return;
        }

        playSound('plant');
        gameState.coins -= crop.seedCost;
        gameState.plots[index] = {
          ...emptyPlot(),
          cropId: crop.id,
          water: 60 // 初期水分60%
        };

        showFloatingEffect(index, `-${crop.seedCost}🪙`, 'text-rose-300');
        await saveGameState();
        return;
      }

      // 以降、作物が植わっている状態
      const crop = CROPS[plot.cropId];
      const progress = getPlotProgress(plot);

      // 【完成している場合】：どのツールでも（スコップ以外）タップで即収穫！
      if (progress >= 1) {
        playSound('harvest');
        const prevLevel = getFarmerLevelInfo(gameState.exp || 0).level;
        const earned = getSellPriceWithBonuses(crop, plot);
        const gainedExp = crop.exp || 10;

        gameState.coins += earned;
        gameState.exp = (gameState.exp || 0) + gainedExp;
        gameState.harvestCounts[crop.id] = (gameState.harvestCounts[crop.id] || 0) + 1;
        gameState.plots[index] = emptyPlot();

        const newLevel = getFarmerLevelInfo(gameState.exp).level;
        showFloatingEffect(index, `+${earned}🪙 +${gainedExp}EXP`, 'text-amber-300');
        showToast(`${crop.names[currentLang]}${t('harvestedMsg')} +${earned}🪙 (+${gainedExp}EXP)`, 'success');

        if (newLevel > prevLevel) {
          setTimeout(() => showToast(`Lv.${newLevel} ${t('levelUpMsg')}`, 'success'), 500);
        }

        await saveGameState();
        return;
      }

      // 【育成中の場合】：選択中のツールに応じてお世話
      if (selectedToolId === 'water' || selectedToolId === 'hand') {
        playSound('water');
        plot.water = (plot.water ?? 60) + 45;

        // 100%を超えると根腐れで枯死！
        if (plot.water > 100) {
          plot.water = 100;
          plot.isWithered = true;
          plot.witherReason = 'overwater';
          playSound('wither');
          showFloatingEffect(index, '💦🥀ROOT ROT!', 'text-rose-400');
          showToast(t('witheredOverwater'), 'error');
        } else if (plot.water > 85) {
          showFloatingEffect(index, '💧+45% ⚠️', 'text-amber-300');
          showToast(t('overWatered'), 'warning');
        } else {
          showFloatingEffect(index, t('waterBoost'), 'text-sky-300');
        }
        await saveGameState();
        return;
      }

      if (selectedToolId === 'speedFert') {
        if (plot.speedFert) {
          showToast(t('alreadyFert'), 'info');
          return;
        }
        if (gameState.coins < 15) {
          showToast(`${t('notEnoughCoins')} (15🪙)`, 'warning');
          return;
        }
        playSound('fert');
        gameState.coins -= 15;
        plot.speedFert = true;
        showFloatingEffect(index, '⚡SPEED UP!', 'text-yellow-300');
        showToast(t('fertApplied'), 'success');
        await saveGameState();
        return;
      }

      if (selectedToolId === 'qualityFert') {
        if (plot.qualityFert) {
          showToast(t('alreadyFert'), 'info');
          return;
        }
        if (gameState.coins < 30) {
          showToast(`${t('notEnoughCoins')} (30🪙)`, 'warning');
          return;
        }
        playSound('fert');
        gameState.coins -= 30;
        plot.qualityFert = true;
        showFloatingEffect(index, '💎QUALITY UP!', 'text-purple-300');
        showToast(t('fertApplied'), 'success');
        await saveGameState();
        return;
      }
    }

    // 一括収穫機能
    window.harvestAllReady = async () => {
      let totalEarned = 0;
      let totalExp = 0;
      let count = 0;
      const prevLevel = getFarmerLevelInfo(gameState.exp || 0).level;

      gameState.plots.forEach((plot, idx) => {
        if (plot.cropId && !plot.isWithered && getPlotProgress(plot) >= 1) {
          const crop = CROPS[plot.cropId];
          const earned = getSellPriceWithBonuses(crop, plot);
          const gainedExp = crop.exp || 10;
          totalEarned += earned;
          totalExp += gainedExp;
          count++;
          gameState.harvestCounts[crop.id] = (gameState.harvestCounts[crop.id] || 0) + 1;
          gameState.plots[idx] = emptyPlot();
          showFloatingEffect(idx, `+${earned}🪙`, 'text-amber-300');
        }
      });

      if (count > 0) {
        playSound('harvest');
        gameState.coins += totalEarned;
        gameState.exp = (gameState.exp || 0) + totalExp;
        const newLevel = getFarmerLevelInfo(gameState.exp).level;

        showToast(`🧺 x${count} (+${totalEarned}🪙 / +${totalExp}EXP)`, 'success');
        if (newLevel > prevLevel) {
          setTimeout(() => showToast(`Lv.${newLevel} ${t('levelUpMsg')}`, 'success'), 500);
        }
        await saveGameState();
      }
    };

    // ==========================================
    // 9. UI切り替え & レンダリング
    // ==========================================
    window.setLanguage = (lang) => {
      currentLang = lang;
      ['ja', 'en', 'es'].forEach(l => {
        const btn = document.getElementById(`lang-${l}`);
        btn.className = l === lang 
          ? 'px-2 py-1 rounded-lg bg-white shadow-sm scale-105 transition' 
          : 'px-2 py-1 rounded-lg opacity-60 hover:opacity-100 transition';
      });
      updateAuthUI(currentUser);
      updateWeatherUI();
      renderAll();
    };

    window.switchTab = (tab) => {
      activeTab = tab;
      const rankBtn = document.getElementById('tab-ranking');
      const statBtn = document.getElementById('tab-stats');
      const rankView = document.getElementById('view-ranking');
      const statView = document.getElementById('view-stats');

      if (tab === 'ranking') {
        rankBtn.className = 'flex-1 py-1.5 px-3 rounded-xl text-xs sm:text-sm font-black transition bg-white text-emerald-800 shadow-sm';
        statBtn.className = 'flex-1 py-1.5 px-3 rounded-xl text-xs sm:text-sm font-black transition text-stone-500 hover:text-stone-700';
        rankView.classList.remove('hidden');
        statView.classList.add('hidden');
      } else {
        statBtn.className = 'flex-1 py-1.5 px-3 rounded-xl text-xs sm:text-sm font-black transition bg-white text-emerald-800 shadow-sm';
        rankBtn.className = 'flex-1 py-1.5 px-3 rounded-xl text-xs sm:text-sm font-black transition text-stone-500 hover:text-stone-700';
        statView.classList.remove('hidden');
        rankView.classList.add('hidden');
      }
    };

    window.selectSeed = (id) => {
      const crop = CROPS[id];
      const lvlInfo = getFarmerLevelInfo(gameState.exp || 0);
      if (crop && lvlInfo.level < crop.reqLevel) {
        showToast(`🔒 Lv.${crop.reqLevel} ${t('levelLocked')}`, 'warning');
        return;
      }
      selectedSeedId = id;
      selectedToolId = 'hand';
      renderTools();
      renderShop();
      renderFarm();
    };

    window.selectTool = (toolId) => {
      selectedToolId = toolId;
      renderTools();
    };

    function renderTools() {
      const barEl = document.getElementById('tool-bar');
      const descEl = document.getElementById('selected-tool-desc');
      const currentTool = TOOLS.find(tool => tool.id === selectedToolId) || TOOLS[0];
      descEl.textContent = t(currentTool.descKey);

      barEl.innerHTML = TOOLS.map(tool => {
        const isSelected = selectedToolId === tool.id;
        return `
          <button 
            onclick="window.selectTool('${tool.id}')"
            class="py-1.5 px-1 rounded-xl border-2 flex flex-col items-center justify-center transition ${
              isSelected 
                ? 'bg-emerald-600 text-white border-emerald-800 shadow-md scale-105' 
                : 'bg-white hover:bg-emerald-100/60 text-stone-700 border-emerald-200'
            }"
          >
            <span class="text-base sm:text-lg leading-none">${tool.icon}</span>
            <span class="text-[10px] font-black mt-1 truncate max-w-full">${t(tool.labelKey)}</span>
            ${tool.cost > 0 ? `<span class="text-[9px] font-bold opacity-90">${tool.cost}🪙</span>` : `<span class="text-[9px] opacity-60">FREE</span>`}
          </button>
        `;
      }).join('');
    }

    function renderLeaderboard() {
      const el = document.getElementById('view-ranking');
      if (!leaderboardData || leaderboardData.length === 0) {
        el.innerHTML = `<p class="text-xs text-stone-500 text-center py-8 font-bold">${t('noRanking')}</p>`;
        return;
      }

      const flags = { ja: '🇯🇵', en: '🇺🇸', es: '🇪🇸' };
      el.innerHTML = leaderboardData.map((user, idx) => {
        const medal = idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : `${idx + 1}.`;
        const flag = flags[user.lang] || '🌍';
        const isMe = currentUser && user.uid === currentUser.uid;
        return `
          <div class="flex items-center justify-between px-3 py-2 rounded-xl border ${isMe ? 'bg-emerald-50 border-emerald-300' : 'bg-stone-50 border-stone-100'}">
            <div class="flex items-center gap-2 min-w-0">
              <span class="font-black text-sm w-6 text-center shrink-0">${medal}</span>
              <span class="text-sm shrink-0">${flag}</span>
              <span class="text-[10px] font-black bg-emerald-100 text-emerald-800 px-1.5 py-0.5 rounded shrink-0">Lv.${user.level || 1}</span>
              <span class="text-xs font-bold text-stone-800 truncate">${user.name || 'Farmer'}</span>
            </div>
            <div class="flex items-center gap-2 shrink-0 text-xs font-black">
              <span class="text-emerald-700">🧺${user.totalHarvest || 0}</span>
              <span class="text-amber-600">🪙${(user.coins || 0).toLocaleString()}</span>
            </div>
          </div>
        `;
      }).join('');
    }

    function applyTranslations() {
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        el.textContent = t(key);
      });
    }

    function updateAuthUI(user) {
      const authArea = document.getElementById('auth-area');
      const syncStatus = document.getElementById('sync-status');

      if (user && !user.isAnonymous) {
        const avatar = user.photoURL
          ? `<img src="${user.photoURL}" alt="avatar" class="w-7 h-7 rounded-full border border-emerald-300" onerror="this.style.display='none'">`
          : `<span class="text-base">🧑‍🌾</span>`;
        authArea.innerHTML = `
          <div class="flex items-center gap-1.5 bg-emerald-50 border border-emerald-200 px-2 py-1 rounded-2xl">
            ${avatar}
            <span class="text-xs font-bold text-emerald-900 hidden sm:inline max-w-[90px] truncate">${user.displayName || 'Farmer'}</span>
            <button onclick="window.handleLogout()" class="text-[11px] bg-white hover:bg-rose-50 text-rose-600 font-bold px-2 py-0.5 rounded-lg border border-rose-200 transition">
              ${t('logoutBtn')}
            </button>
          </div>
        `;
        syncStatus.textContent = t('cloudSaved');
      } else {
        authArea.innerHTML = `
          <button onclick="window.handleGoogleLogin()" class="bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white text-xs font-bold px-3 py-1.5 rounded-2xl shadow-sm transition flex items-center gap-1.5">
            <span>🔑</span> <span>${t('loginBtn')}</span>
          </button>
        `;
        syncStatus.textContent = t('guestStatus');
      }
    }

    window.handleGoogleLogin = async () => {
      try {
        await signInWithPopup(auth, googleProvider);
        showToast(t('loginSuccess'), 'success');
      } catch (error) {
        console.error("Google login error:", error);
        showToast(error.message || 'Login failed', 'error');
      }
    };

    window.handleLogout = async () => {
      try {
        await signOut(auth);
      } catch (error) {
        console.error("Logout error:", error);
      }
    };

    async function initAuth() {
      onAuthStateChanged(auth, (user) => {
        currentUser = user;
        updateAuthUI(user);
        if (user) {
          startListeningUserData(user.uid);
          startListeningLeaderboard();
        } else {
          if (unsubscribeUser) unsubscribeUser();
          if (unsubscribeLeaderboard) unsubscribeLeaderboard();
          gameState = createInitialGameState();
          renderAll();
        }
      });

      if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
        try {
          await signInWithCustomToken(auth, __initial_auth_token);
        } catch (e) {
          await signInAnonymously(auth).catch(() => {});
        }
      } else if (!auth.currentUser) {
        // ゲスト時も匿名認証を行い、request.auth != null のルールを通過できるようにする
        await signInAnonymously(auth).catch(() => {});
      }
    }

    function renderShop() {
      const shopEl = document.getElementById('seed-shop');
      const lvlInfo = getFarmerLevelInfo(gameState.exp || 0);

      shopEl.innerHTML = Object.values(CROPS).map(crop => {
        const isLocked = lvlInfo.level < crop.reqLevel;
        const isSelected = !isLocked && selectedSeedId === crop.id && selectedToolId === 'hand';
        const sellPrice = getSellPriceWithBonuses(crop, null);

        if (isLocked) {
          return `
            <button 
              onclick="window.selectSeed('${crop.id}')"
              class="text-left p-2.5 rounded-2xl border-2 border-stone-200 bg-stone-100/80 opacity-70 flex flex-col justify-between cursor-not-allowed"
            >
              <div class="flex items-center justify-between w-full mb-1">
                <span class="text-xl sm:text-2xl grayscale">🔒</span>
                <span class="text-[10px] font-black px-2 py-0.5 rounded-full bg-stone-300 text-stone-700">
                  Lv.${crop.reqLevel}
                </span>
              </div>
              <div class="font-bold text-xs text-stone-500 truncate w-full">${crop.names[currentLang]}</div>
              <div class="text-[10px] text-stone-400 mt-0.5">
                Unlock at Lv.${crop.reqLevel}
              </div>
            </button>
          `;
        }

        return `
          <button 
            onclick="window.selectSeed('${crop.id}')"
            class="text-left p-2.5 rounded-2xl border-2 transition-all flex flex-col justify-between ${
              isSelected 
                ? 'bg-amber-50 border-amber-400 shadow-md scale-[1.02]' 
                : 'bg-white hover:bg-stone-50 border-stone-200'
            }"
          >
            <div class="flex items-center justify-between w-full mb-1">
              <div class="flex items-center gap-1">
                <span class="text-xl sm:text-2xl">${crop.icon}</span>
                <span class="text-[9px] font-black px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800">Lv.${crop.reqLevel}</span>
              </div>
              <span class="text-[11px] font-black px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">
                ${crop.seedCost}🪙
              </span>
            </div>
            <div class="font-bold text-xs sm:text-sm text-stone-800 truncate w-full">${crop.names[currentLang]}</div>
            <div class="text-[10px] text-stone-500 mt-0.5 flex justify-between w-full">
              <span>⏱️${crop.growTimeSec}s ✨+${crop.exp}</span>
              <span class="text-emerald-600 font-bold">${sellPrice}🪙</span>
            </div>
          </button>
        `;
      }).join('');
    }

    function renderStats() {
      const statsEl = document.getElementById('view-stats');
      statsEl.innerHTML = Object.values(CROPS).map(crop => {
        const count = gameState.harvestCounts?.[crop.id] || 0;
        return `
          <div class="flex items-center justify-between bg-stone-50 px-3 py-2 rounded-xl border border-stone-100">
            <div class="flex items-center gap-2.5">
              <span class="text-xl">${crop.icon}</span>
              <div class="text-xs font-bold text-stone-800">${crop.names[currentLang]}</div>
            </div>
            <div class="font-black text-xs text-emerald-700 bg-emerald-100/80 px-2.5 py-1 rounded-lg">
              ${count}
            </div>
          </div>
        `;
      }).join('');
    }

    function renderFarm() {
      const gridEl = document.getElementById('farm-grid');
      gridEl.innerHTML = '';

      gameState.plots.forEach((plot, index) => {
        const cell = document.createElement('button');
        cell.setAttribute('data-plot-index', index);
        cell.onclick = () => handlePlotClick(index);

        let soilClass = '';
        if (plot.cropId) {
          if (plot.isWithered) soilClass = 'withered';
          else if ((plot.water ?? 60) >= 35) soilClass = 'watered';
          else soilClass = 'dry';
        }

        cell.className = `farm-plot ${soilClass} rounded-2xl sm:rounded-3xl relative flex flex-col items-center justify-center p-2 cursor-pointer overflow-hidden`;

        if (!plot.cropId) {
          const selectedCrop = CROPS[selectedSeedId];
          cell.innerHTML = `
            <span class="text-stone-300/40 text-2xl sm:text-3xl font-bold">+</span>
            <span class="text-[10px] text-amber-100/80 font-bold mt-1 text-center leading-tight">
              ${selectedCrop.names[currentLang]}${t('plantHint')}
            </span>
          `;
        } else if (plot.isWithered) {
          // 枯死状態の表示
          cell.innerHTML = `
            <span class="absolute top-1.5 right-1.5 bg-rose-600 text-white text-[9px] font-black px-2 py-0.5 rounded-full shadow">${t('witheredBadge')}</span>
            <div class="text-3xl sm:text-5xl grayscale opacity-80 my-1">🥀</div>
            <span class="text-[10px] text-rose-200 font-bold mt-1 bg-black/50 px-2 py-0.5 rounded-full">
              ${t('tapShovel')}
            </span>
          `;
        } else {
          const crop = CROPS[plot.cropId];
          const progress = getPlotProgress(plot);
          const percent = Math.floor(progress * 100);
          const waterPct = Math.round(plot.water ?? 60);

          let stageEmoji = '🌱';
          let animClass = 'animate-crop';
          let statusBadge = '';

          if (progress >= 1) {
            stageEmoji = crop.cropEmoji;
            animClass = 'animate-ready';
            // 腐敗までの残り時間計算
            const elapsedReady = (Date.now() - (plot.readySince || Date.now())) / 1000;
            const remainFresh = Math.max(0, Math.ceil(crop.freshTimeSec - elapsedReady));
            const urgentClass = remainFresh <= 10 ? 'bg-rose-500 text-white animate-ping' : 'bg-amber-400 text-amber-950';
            statusBadge = `<span class="absolute top-1.5 right-1.5 ${urgentClass} text-[9px] font-black px-1.5 py-0.5 rounded-full shadow">⏰${remainFresh}s</span>`;
          } else if (progress >= 0.5) {
            stageEmoji = '🌿';
          }

          // 肥料アイコン表示
          const fertBadges = `${plot.speedFert ? '⚡' : ''}${plot.qualityFert ? '💎' : ''}`;

          // 水分バーの色（危険域は赤・黄色）
          let waterColor = 'bg-sky-400';
          if (waterPct <= 20) waterColor = 'bg-rose-500 animate-pulse';
          else if (waterPct > 85) waterColor = 'bg-amber-400';

          cell.innerHTML = `
            ${statusBadge}
            <div class="text-[10px] absolute top-1.5 left-2 font-bold drop-shadow">${fertBadges}</div>
            <div class="text-3xl sm:text-5xl ${animClass} my-0.5">${stageEmoji}</div>
            
            <!-- 成長ゲージ -->
            <div class="w-4/5 bg-black/50 h-1.5 rounded-full overflow-hidden mt-1 border border-white/20">
              <div class="h-full transition-all duration-300 ${progress >= 1 ? 'bg-amber-400' : 'bg-emerald-400'}" style="width: ${percent}%"></div>
            </div>

            <!-- 水分ゲージ（成長中のみ表示） -->
            ${progress < 1 ? `
              <div class="w-4/5 bg-black/50 h-1.5 rounded-full overflow-hidden mt-1 border border-white/20 flex items-center" title="Water: ${waterPct}%">
                <div class="h-full transition-all duration-300 ${waterColor}" style="width: ${waterPct}%"></div>
              </div>
              <span class="text-[9px] text-white font-bold mt-0.5 drop-shadow">
                🌱${percent}% &nbsp; 💧${waterPct}%
              </span>
            ` : `
              <span class="text-[10px] text-amber-200 font-black mt-1 drop-shadow">
                ${t('tapHarvest')} (${getSellPriceWithBonuses(crop, plot)}🪙)
              </span>
            `}
          `;
        }

        gridEl.appendChild(cell);
      });
    }

    function renderAll() {
      applyTranslations();
      document.getElementById('coin-display').textContent = gameState.coins.toLocaleString();

      const lvlInfo = getFarmerLevelInfo(gameState.exp || 0);
      document.getElementById('level-display').textContent = lvlInfo.level;
      document.getElementById('exp-text').textContent = `${lvlInfo.currentExp}/${lvlInfo.nextLevelExp}`;
      document.getElementById('exp-bar').style.width = `${lvlInfo.percent}%`;

      renderTools();
      renderShop();
      renderStats();
      renderLeaderboard();
      renderFarm();
    }

    // 毎秒の更新ループ（作物の成長・水分減少・枯死＆天気チェック）
    setInterval(() => {
      updateWeatherUI();
      simulateTick();
    }, 1000);

    // 初期化
    window.setLanguage(currentLang);
    updateWeatherUI();
    initAuth();
  </script>
</body>
</html>
