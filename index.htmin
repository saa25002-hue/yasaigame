        descQuality: '収穫時の売値 1.5倍 (30🪙)',
        toolShovel: 'スコップ',
        descShovel: '枯れた作物や不要な作物を撤去',
        syncing: 'クラウド同期中...',
        cloudSaved: '☁️ クラウド保存済み',
        guestStatus: 'ゲストモード（ログインで世界ランキング参加）',
        loginBtn: 'Googleログイン',
        logoutBtn: 'ログアウト',
        loginSuccess: 'Googleアカウントでログインしました！',
        noRanking: 'まだランキングデータがありません。一番乗りを目指そう！',
        plantHint: 'を植える',
        witheredBadge: '枯死',
        tapShovel: '⛏️スコップで撤去',
        tapHarvest: '✨タップで収穫！',
        witheredDry: '🥀 作物が枯れてしまいました！スコップで撤去してください',
        witheredOverwater: '💦 水のやりすぎで根腐れしました！',
        overWatered: '⚠️ 水分過多！100%を超えると根腐れします',
        waterBoost: '💧+45%',
        cleanedPlot: '⛏️ 畑をきれいにしました',
        needShovel: '🥀 枯れています！スコップツールで撤去してください',
        notEnoughCoins: 'コインが足りません！',
        harvestedMsg: 'を収穫！',
        alreadyFert: 'すでにこの肥料は使用済みです',
        fertApplied: '🧪 肥料を与えました！',
        levelLocked: '必要レベルに達していません！',
        levelUpMsg: '🎉 レベルアップ！新しいタネが解放されました！'
      },
      en: {
        farmTitle: 'Your Farm',
        harvestAll: 'Harvest All',
        toolTitle: 'Tools & Fertilizers (Select & Tap Plot)',
        guideWater: '0% Water = Wither',
