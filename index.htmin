        weatherRainy: '🌧️ Rainy: Auto-water & 2x Growth!',
        weatherRainbow: '🌈 Rainbow: 1.5x Sell Price Bonus!',
        toolHand: 'Plant/Water',
        descHand: 'Plant seed on empty plot / Water crop',
