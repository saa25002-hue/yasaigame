        weatherRainy: '🌧️ Lluvia: Riego auto y Crecimiento x2',
        weatherRainbow: '🌈 Arcoíris: ¡Bono x1.5 en monedas!',
        toolHand: 'Sembrar/Regar',
        descHand: 'Sembrar en tierra vacía / Regar cultivo',
        toolWater: 'Regadera',
        descWater: 'Agua +45% (>100% pudre raíces)',
        toolSpeed: 'Abono Veloz',
        descSpeed: 'Velocidad x1.6 (15🪙)',
        toolQuality: 'Abono Calidad',
        descQuality: 'Valor de venta x1.5 (30🪙)',
        toolShovel: 'Pala',
        descShovel: 'Quitar cultivos marchitos',
        syncing: 'Sincronizando...',
        cloudSaved: '☁️ Guardado en Nube',
        guestStatus: 'Modo Invitado (Inicia sesión para Ranking)',
        loginBtn: 'Entrar con Google',
        logoutBtn: 'Salir',
        loginSuccess: '¡Sesión iniciada con Google!',
        noRanking: 'Aún no hay granjeros. ¡Sé el primero!',
        plantHint: '',
        witheredBadge: 'MARCHITO',
        tapShovel: '⛏️Usar Pala',
        tapHarvest: '✨¡Toca para cosechar!',
        witheredDry: '🥀 ¡Un cultivo se marchitó! Límpialo con la pala.',
        witheredOverwater: '💦 ¡Exceso de agua pudrió las raíces!',
        overWatered: '⚠️ ¡Demasiada agua! >100% pudrirá el cultivo',
        waterBoost: '💧+45%',
        cleanedPlot: '⛏️ ¡Parcela limpia!',
        needShovel: '🥀 ¡Marchito! Usa la pala para limpiar.',
        notEnoughCoins: '¡No tienes suficientes monedas!',
        harvestedMsg: ' cosechado!',
        alreadyFert: '¡Este abono ya está aplicado!',
        fertApplied: '🧪 ¡Abono aplicado!',
        levelLocked: '¡Nivel de granjero insuficiente!',
        levelUpMsg: '🎉 ¡Subiste de nivel! ¡Nuevas semillas desbloqueadas!'
      }
    };

    function t(key) {
      return (I18N[currentLang] && I18N[currentLang][key]) || I18N.ja[key] || key;
    }

    // ==========================================
    // 3. 世界共通の野菜・フルーツデータ（全26種類・必要レベル＆EXP付き）
    // ==========================================
    const CROPS = {
      radish: {
        id: 'radish',
        reqLevel: 1,
        exp: 10,
        names: { ja: 'ラディッシュ', en: 'Radish', es: 'Rábano' },
        seedCost: 10,
        sellPrice: 30,
        growTimeSec: 14,
        waterDrainPerSec: 2.0,
        freshTimeSec: 28,
